# 복사해서 .env로 만든 뒤 값을 채워 넣으세요. (.env는 커밋되지 않음)
DB_URL=jdbc:mysql://localhost:3306/fintris?serverTimezone=Asia/Seoul
DB_USERNAME=
DB_PASSWORD=
# 로컬에서만 update 사용 (미설정 시 validate)
JPA_DDL_AUTO=update
# 32자 이상의 임의 문자열 (HS256 서명 키)
JWT_SECRET=
# CODEF (데모: https://development.codef.io, 샌드박스: https://sandbox.codef.io)
CODEF_BASE_URL=https://development.codef.io
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=
